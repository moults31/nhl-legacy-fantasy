# Port the API server listens on
PORT=3001

# SQLite database path
DATABASE_URL=apps/api/data/dev.db

# Path to the mule CLI binary (built by scripts/setup.sh)
# Default: .cargo-bin/bin/roster-cli
# MULE_BINARY=

# Path to a vanilla NHL Legacy roster .bin file
# Default: tests/fixtures/xbox/roster.bin (trade deadline update)
# VANILLA_ROSTER_BIN=

# Xenia/Proton save root — parent of 00000001/ and Headers/
# Default on Linux: ~/.steam/steam/steamapps/compatdata/<id>/pfx/...B13EBABEBABEBABE/454109EC
# Default on Windows: %USERPROFILE%/Documents/nhllegacy/B13EBABEBABEBABE/454109EC
# XENIA_SAVE_ROOT=

# Allowed CORS origin
CORS_ORIGIN=http://localhost:5173
