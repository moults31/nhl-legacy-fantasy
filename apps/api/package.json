{
  "name": "@nlf/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "find dist -name '*.test.js' -exec node --test {} +",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "rm -f data/dev.db && pnpm db:seed"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@nlf/spec-client": "workspace:*",
    "better-sqlite3": "^12.0.1",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
